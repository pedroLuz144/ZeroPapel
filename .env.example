# Copie este arquivo para .env na raiz do projeto e preencha os valores.
# A aplicacao le o .env sozinha na subida; variavel de ambiente real tem precedencia sobre ele.
# Formato: CHAVE=valor, sem aspas e sem "export". Barra invertida no valor precisa ser dobrada (\\).

# ---------------------------------------------------------------------------
# Banco de dados (MariaDB)
# ---------------------------------------------------------------------------
# O schema (aqui, zeropapel) precisa existir; as tabelas sao criadas pelo Flyway
URL_BD=jdbc:mariadb://localhost:3306/zeropapel
USER_BD=seu_usuario
SENHA_BD=troque-esta-senha

# ---------------------------------------------------------------------------
# Autenticacao (JWT)
# ---------------------------------------------------------------------------
# Chave em base64 com no minimo 32 bytes depois de decodificar; abaixo disso a aplicacao nao sobe
# Gere com: openssl rand -base64 64
JWT_SECRET=troque-por-uma-chave-gerada-com-openssl
# Validade do access token, em milissegundos (86400000 = 24 horas)
JWT_EXPIRATION_MS=86400000

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
# Unica origem de navegador aceita pela API, sem barra no fim e sem caminho
# Desenvolvimento com npm run dev: http://localhost:5173 (o navegador envia esse Origin e o proxy
# do Vite nao o reescreve; com outro valor, login e demais POST voltam 403 Invalid CORS request)
# SPA embutida no jar: mesma origem da API, o CORS nem entra em jogo; use http://localhost:8080
# ou, em producao, o endereco publico do sistema
CORS_ALLOWED_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------------------
# Usuario master inicial
# ---------------------------------------------------------------------------
# So tem efeito com a tabela de usuarios vazia: na subida, cria um GERENTE com este login e senha
# Com qualquer usuario ja cadastrado, as tres variaveis sao ignoradas
# Nao existe senha padrao: ADMIN_SENHA vem em branco de proposito e precisa ser preenchida
# Enquanto ela estiver em branco, nenhum usuario e criado e a subida so avisa no log
# A senha segue a regra do cadastro (minimo de 4 caracteres); troque-a depois do primeiro login
ADMIN_USUARIO=admin
ADMIN_SENHA=
# Nome de exibicao, opcional; em branco vira "Administrador"
ADMIN_NOME=Administrador

# ---------------------------------------------------------------------------
# Dados de demonstracao (scripts/popular_banco.py)
# ---------------------------------------------------------------------------
# Opcional: senha dos usuarios criados pelo script
# Em branco, o script gera uma senha aleatoria e imprime no fim
SEED_SENHA=

# ---------------------------------------------------------------------------
# Integracao iFood
# ---------------------------------------------------------------------------
# Credenciais do aplicativo Centralizado do portal do desenvolvedor (developer.ifood.com.br)
# Sao do aplicativo, nao da loja; o Merchant ID de cada loja vai no canal de venda, pela tela
# Opcionais: em branco, a aplicacao sobe normalmente e a integracao nao chama o iFood
IFOOD_CLIENT_ID=
IFOOD_CLIENT_SECRET=
# Ingestao dos pedidos (polling a cada 30 s + confirmacao de recebimento). Desligada por padrao
# Antes de ligar: cadastre o canal iFood da loja com o Merchant ID e preencha a forma de pagamento
IFOOD_POLLING_ATIVO=false
# ID da forma de pagamento gravada nos pedidos do iFood (crie uma com taxa 0, ex.: "iFood online":
# a comissao do iFood ja e a taxa do canal de venda). Obrigatoria com o polling ligado
IFOOD_FORMA_DE_PAGAMENTO_ID=
